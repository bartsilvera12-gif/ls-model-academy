# LS Model Management — configuracion Apache (Hostinger)

# ----------------------------------------------------------------
# HTTPS y dominio canonico
# ----------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Quitar el www. Si preferis el sitio CON www, comenta este bloque
  # y descomenta el siguiente.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # URLs limpias opcionales: /modelos tambien sirve modelos.html.
  # No se fuerza la redireccion inversa a proposito: los enlaces del
  # sitio usan .html y redirigirlos sumaria un 301 a cada navegacion.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # /index.html es la home: se sirve desde la raiz
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /404.html

# ----------------------------------------------------------------
# Compresion
# ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
  # Las imagenes y el video ya vienen comprimidos: recomprimir solo gasta CPU
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
</IfModule>

# ----------------------------------------------------------------
# Cache del navegador
# ----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  # El HTML no se cachea: si no, los cambios tardan en verse
  ExpiresByType text/html                 "access plus 0 seconds"

  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"

  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|mp4|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ----------------------------------------------------------------
  # Seguridad
  # ----------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # El servidor no necesita anunciar su version
  Header unset X-Powered-By
</IfModule>

# ----------------------------------------------------------------
# Tipos MIME
# ----------------------------------------------------------------
<IfModule mod_mime.c>
  AddType video/mp4                 .mp4
  AddType image/webp                .webp
  AddType image/svg+xml             .svg
  AddType font/woff2                .woff2
  AddType image/x-icon              .ico
</IfModule>

# ----------------------------------------------------------------
# Archivos que no deben servirse nunca
# ----------------------------------------------------------------
# Datos personales de las modelos, fuentes y configuracion.
<FilesMatch "(^\.|\.(txt|md|sh|json|MOV|HEIC|bak|log)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# robots.txt es la excepcion: debe poder leerse
<Files "robots.txt">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>

# Sin listados de directorio
Options -Indexes
